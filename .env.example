# World App Foundation — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ─── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/worldapp

# Session secret — use a long random string (32+ chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-secure-random-string

# ─── Optional ─────────────────────────────────────────────────────────────────

# Server port (defaults to PORT env var set by the platform, or 3001)
PORT=3001

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Node environment: development | production | test
NODE_ENV=development
